// Cloudflare deploy config. The site is static files: `npm run build` makes dist/, and `wrangler deploy`
// uploads it as-is. Having this file stops Wrangler from "auto-configuring" the project (which adds a
// Vite plugin that breaks the prerender step).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyvo",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
